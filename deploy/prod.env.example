# Settings of docker-compose.prod.yml, the production rehearsal. Copy this file to deploy/prod.env (git ignores it,
# and so does the image build) and pass the copy to every Compose command:
#   cp deploy/prod.env.example deploy/prod.env
#   docker compose -f docker-compose.prod.yml --env-file deploy/prod.env up -d --wait
# Placeholders only: no value in this file is a secret, and the empty ones are filled in on the host.

# Required. The site name Caddy serves and gets a certificate for. localhost: a certificate from Caddy's local CA,
# for a rehearsal on one machine. A public name: one from Let's Encrypt, once the name resolves to the host and
# ports 80 and 443 reach it.
DOMAIN=localhost

# Required. The Postgres password; it goes into a connection URL, so letters and digits only (openssl rand -hex 24).
POSTGRES_PASSWORD=

# Optional. The Anthropic API key POST /api/answer uses. Empty: answers are off, and POST /api/retrieve/ works as
# before. Set a spend limit in the Anthropic Console too: ANSWER_DAILY_BUDGET_USD is the app's own estimate, not a bill.
ANTHROPIC_API_KEY=

# The answer model and the global daily answer budget in estimated dollars: the owner's cheap profile (2026-11-21),
# the values infra/envs/production sets. Claude Haiku 5.5 (used once ANTHROPIC_API_KEY is set) and $0.75 a day: at
# most $23.25 in a 31-day month, under a $24 monthly spend limit in the Anthropic Console (doc/deploy.md, Claude's
# cost). With a line commented out or empty, docker-compose.prod.yml uses the deploy contract's default instead:
# claude-opus-5-5 and 2.00.
ANSWER_MODEL=claude-haiku-5-5
ANSWER_DAILY_BUDGET_USD=0.75

# Optional, with the defaults docker-compose.prod.yml uses when a line stays commented out or empty.
# The api image. main-ml moves on every push to main; a sha-<commit>-ml tag runs one build.
# METANAVIT_IMAGE=ghcr.io/joses2017smjh/metanavt:main-ml
# The answer route's other settings.
# ANSWER_EFFORT=low
# ANSWER_MAX_TOKENS=4096
# ANSWER_TIMEOUT_SECONDS=30
# ANSWER_MAX_RETRIES=2
# The answer cache's TTL and the per-caller quotas.
# ANSWER_CACHE_TTL_SECONDS=86400
# ANSWER_LIMIT_PER_MINUTE=5
# ANSWER_LIMIT_PER_DAY=50
# The CORS origin (default: https:// and DOMAIN, the origin this stack serves the web client from).
# WEB_ORIGIN=https://localhost
# The api's request body cap in bytes. Above 16384, raise request_body max_size in deploy/Caddyfile too.
# MAX_BODY_BYTES=8192
