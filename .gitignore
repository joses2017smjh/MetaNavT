# make bench writes bench/results/<git-sha>.json on every run; only the
# baseline (main.json), the newest run (latest.json) and the committed
# reference runs are tracked. `git add -f` to keep a specific run.
bench/results/*.json
!bench/results/latest.json
!bench/results/main.json
# per-question sidecars (app/eval/per_question.py) of the tracked harness results files; a file recorded before the
# sidecar existed gets one when it is re-recorded
!bench/results/latest.per_query.json
!bench/results/main.per_query.json
!bench/results/neural.per_query.json
!bench/results/frontier.per_query.json
!bench/results/frontier_neural.per_query.json
!bench/results/rerank_depth.per_query.json
!bench/results/parity_shared_chunker.per_query.json
!bench/results/parity_shared_chunker_restart.per_query.json
!bench/results/parity_neural.per_query.json
!bench/results/sweeps.json
!bench/results/520699a.json
# neural / external results are committed artifacts (see their headers for the command)
!bench/results/neural.json
!bench/results/beir_scifact.json
!bench/results/beir_scifact_bm25_ablation.json
!bench/results/beir_scifact_rerank_cap.json
!bench/results/beir_fiqa.json
# M49 late interaction (app/eval/late_interaction.py): each dataset's primary and extra files with their sidecars, the
# ATTEMPT 2 files if any, and the indicative CPU file; the committed runs (.gz) under late_interaction_runs/ are not ignored
!bench/results/late_interaction*.json
!bench/results/beir_scifact_late_interaction*.json
!bench/results/beir_fiqa_late_interaction*.json
# the served path at FiQA scale and pgvector on its table (make bench-served-scale)
!bench/results/served_scale_fiqa.json
!bench/results/served_scale_fiqa_pre_m20.json
!bench/results/pgvector_hnsw.json
!bench/results/parity.json
!bench/results/parity_shared_chunker.json
!bench/results/parity_shared_chunker_restart.json
# the model-backed parity run (make parity PARITY_CONFIG=..., a GPU job) and the served reranker settings on the fixture (make bench-rerank-depth)
!bench/results/parity_neural.json
!bench/results/rerank_depth.json
!bench/results/ingest_runs.json
!bench/results/ingest_scale.json
!bench/results/two_replicas.json
!bench/results/api_latency_*.json
!bench/results/jury.json
!bench/results/jury_v2.json
# M42: generate-only answers per generator (make bench-jury-v3-answers) and one judge file per judge (make
# bench-jury-v3-judge), each holding its gate verdicts and every verdict on the stored answers
!bench/results/jury_v3_answers_*.json
!bench/results/jury_v3_judge_*.json
# `make bench-judge-stored ANSWERS=<file>`'s default output beside its answers (e.g. the recorded Claude answers)
!bench/results/*_judged_by_*.json
!bench/results/robotics_file_lookup_2026-10-07.json
!bench/results/robotics_file_lookup_revalidated_2026-10-07.json
!bench/results/robotics_chunking.json
!bench/results/robotics_multiquery.json
# the search policy trained once (M44): the results file and its two sidecars (make search-policy-eval; make search-policy-rescore recomputes it)
!bench/results/search_policy.json
!bench/results/search_policy.rollouts.json
!bench/results/search_policy.training.json

# editable install metadata
*.egg-info/

# external benchmark downloads (BEIR SciFact) and embedding caches; results are committed
bench/external/

# Signed approval / structured evidence regression artifacts
!bench/results/trusted_actions.json
!bench/results/trusted_actions_v2.json
!bench/results/evidence_consistency.json
# LLM-in-the-loop injection results; the episodes JSONL next to it is tracked as well, and so is the
# rescored per-episode scores JSONL (make bench-agent-injection-scores) with its sidecar
!bench/results/agent_injection.json
!bench/results/agent_injection_episodes.meta.json
!bench/results/agent_injection_episodes_rescored.meta.json
# the second injection run (make bench-agent-injection-v2): capability control and controls with neutral lines
!bench/results/agent_injection_v2.json
!bench/results/agent_injection_v2_episodes.meta.json
# phrasings scored as any-success and the in-loop answer check (make bench-agent-injection-v3, or its shards merged by
# make bench-agent-injection-v3-merge); the shard files stay untracked, the merged episodes file holds every row
!bench/results/agent_injection_v3.json
!bench/results/agent_injection_v3_episodes.meta.json
bench/results/agent_injection_v3_shards/
# the adaptive attacker on the held-out questions (make bench-agent-injection-adaptive, or its shards merged by
# make bench-agent-injection-adaptive-merge); shards and the tuning runs on the training questions stay untracked
!bench/results/agent_injection_adaptive.json
!bench/results/agent_injection_adaptive_episodes.meta.json
bench/results/agent_injection_adaptive_shards/
bench/results/agent_injection_adaptive_tune/
# prototype arms vs their parents (make bench-frontier, make bench-frontier-neural)
!bench/results/frontier.json
!bench/results/frontier_neural.json
# the LLM-written HyDE hypotheses and chunk prefixes the real-model frontier reads (make frontier-generations)
!bench/results/frontier_generations.json
!bench/results/rerank_arms.json
# the research companion's live-mode run (make bench-companion-live): every stored response is in the file
!bench/results/companion_live.json
# the chat routes with a real model (make chat-route-smoke)
!bench/results/chat_route_smoke.json
# RRF k and the dense-vs-BM25 weight chosen on half the gold questions, scored on the other half (make bench-rrf-sweep)
!bench/results/rrf_sweep.json
# per question, the gold files hybrid@bge-base drops at Recall@50 against dense_only@bge-base (make bench-hybrid-drops)
!bench/results/hybrid_drops_bge_base.json
# M37: the file-depth rows beside their chunk-cut parents (make bench-file-depth, a GPU job) with their per-question
# sidecar, and the RRF sweep with the hash embedder (make bench-rrf-sweep-hash), recorded as not blind
!bench/results/file_depth.json
!bench/results/file_depth.per_query.json
!bench/results/rrf_sweep_hash.json
# M41: the current open models beside their bge parents, recomputed in each run: fixture v1 (make bench-models-2026,
# bench-models-2026-harrier, bench-models-2026-cpu) with their per-question sidecars, and BEIR SciFact and FiQA
# (make bench-beir-models-2026, bench-beir-fiqa-models-2026 and their -harrier runs)
!bench/results/models_2026.json
!bench/results/models_2026.per_query.json
!bench/results/models_2026_harrier.json
!bench/results/models_2026_harrier.per_query.json
!bench/results/models_2026_cpu.json
!bench/results/models_2026_cpu.per_query.json
!bench/results/beir_scifact_models_2026.json
!bench/results/beir_fiqa_models_2026.json
!bench/results/beir_scifact_models_2026_harrier.json
!bench/results/beir_fiqa_models_2026_harrier.json
# M43: the small rerankers over hybrid@bge-small at the served shape, each with its per-query sidecar (make
# bench-small-rerankers, bench-beir-small-rerankers, bench-beir-fiqa-small-rerankers), and what they cost on a CPU
# (scripts/measure_rerank_cpu.py, indicative). The synthetic queries and the teacher's scores are in bench/distill/.
!bench/results/small_rerankers.json
