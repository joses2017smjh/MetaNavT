# make bench writes bench/results/<git-sha>.json on every run; only the
# baseline (main.json), the newest run (latest.json) and the committed
# reference runs are tracked. `git add -f` to keep a specific run.
bench/results/*.json
!bench/results/latest.json
!bench/results/main.json
!bench/results/sweeps.json
!bench/results/520699a.json
# neural / external results are committed artifacts (see their headers for the command)
!bench/results/neural.json
!bench/results/beir_scifact.json
!bench/results/beir_scifact_bm25_ablation.json
!bench/results/beir_scifact_rerank_cap.json
!bench/results/beir_fiqa.json
!bench/results/parity.json
!bench/results/parity_shared_chunker.json
!bench/results/parity_shared_chunker_restart.json
# the model-backed parity run (make parity PARITY_CONFIG=..., a GPU job) and the served reranker settings on the fixture (make bench-rerank-depth)
!bench/results/parity_neural.json
!bench/results/rerank_depth.json
!bench/results/ingest_runs.json
!bench/results/api_latency_*.json
!bench/results/jury.json
!bench/results/jury_v2.json
!bench/results/robotics_file_lookup_2026-10-07.json
!bench/results/robotics_file_lookup_revalidated_2026-10-07.json
!bench/results/robotics_chunking.json
!bench/results/robotics_multiquery.json

# editable install metadata
*.egg-info/

# external benchmark downloads (BEIR SciFact) and embedding caches; results are committed
bench/external/

# Signed approval / structured evidence regression artifacts
!bench/results/trusted_actions.json
!bench/results/trusted_actions_v2.json
!bench/results/evidence_consistency.json
# LLM-in-the-loop injection results; the episodes JSONL next to it is tracked as well, and so is the
# rescored per-episode scores JSONL (make bench-agent-injection-scores) with its sidecar
!bench/results/agent_injection.json
!bench/results/agent_injection_episodes.meta.json
!bench/results/agent_injection_episodes_rescored.meta.json
# the current injection run (make bench-agent-injection-v2): capability control and controls with neutral lines
!bench/results/agent_injection_v2.json
!bench/results/agent_injection_v2_episodes.meta.json
# prototype arms vs their parents (make bench-frontier, make bench-frontier-neural)
!bench/results/frontier.json
!bench/results/frontier_neural.json
# the LLM-written HyDE hypotheses and chunk prefixes the real-model frontier reads (make frontier-generations)
!bench/results/frontier_generations.json
!bench/results/rerank_arms.json
# the research companion's live-mode run (make bench-companion-live): every stored response is in the file
!bench/results/companion_live.json
# the chat routes with a real model (make chat-route-smoke)
!bench/results/chat_route_smoke.json
# RRF k and the dense-vs-BM25 weight chosen on half the gold questions, scored on the other half (make bench-rrf-sweep)
!bench/results/rrf_sweep.json
# per question, the gold files hybrid@bge-base drops at Recall@50 against dense_only@bge-base (make bench-hybrid-drops)
!bench/results/hybrid_drops_bge_base.json

# Task-local service and Slurm logs stay out of the measured evidence commit.
bench/results/revamp_20261007/**/*.log
