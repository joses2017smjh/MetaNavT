# MetaNaviT Environment Configuration

# ===============================
# Model Provider Configuration
# ===============================
# The provider for the AI models to use (ollama, openai, gemini, azure)
MODEL_PROVIDER=ollama

# The name of LLM model to use
MODEL=qwen2.5:14b

# For Ollama provider
OLLAMA_BASE_URL=http://localhost:11434

# For OpenAI provider
# OPENAI_API_KEY=your_openai_api_key

# For Gemini provider
# GOOGLE_API_KEY=your_google_api_key

# For Azure OpenAI provider
# AZURE_OPENAI_API_KEY=your_azure_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_API_VERSION=2023-05-15
# AZURE_OPENAI_LLM_DEPLOYMENT=your_deployment_name
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your_embedding_deployment_name

# ===============================
# Embedding Configuration
# ===============================
# huggingface (default; needs the `ml` extra and downloads EMBEDDING_MODEL) or
# hash (deterministic n-gram hashing, no download; what docker-compose and CI use)
EMBEDDING_PROVIDER=huggingface

# Name of the embedding model to use (huggingface provider)
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Dimension of the embedding model to use (1024 for bge-large; 256 for the hash adapter).
# The pgvector table is created with this width; drop it to change dimension.
EMBEDDING_DIM=1024

# Bring the pgvector index in line with DATA_DIR on every API start (docker-compose sets true):
# only new or changed files are embedded, rows of removed files are deleted.
INDEX_ON_START=false
# Fail the indexing run when more files than this are rejected (undecodable, empty, too large,
# unsupported type, duplicate content). Unset: rejections are counted in /health but not fatal.
# INGEST_MAX_REJECTED=0
# Largest file indexed, in bytes, and the indexed suffixes (comma-separated; * = every type).
# INGEST_MAX_FILE_BYTES=1048576
# INGEST_SUFFIXES=.yaml,.md,.out

# ===============================
# Model Parameters
# ===============================
# Temperature for sampling from the model (0.0 to 1.0)
LLM_TEMPERATURE=0.2

# Maximum number of tokens to generate
LLM_MAX_TOKENS=4096

# Retrieve wide (hybrid), then rerank narrow
RETRIEVE_K=50
RERANK_TOP_N=8
TOP_K=8

# Chunk sizes tuned for BAAI/bge-large-en-v1.5 (512 token context)
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Reranker model (set to "none" to disable)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Rule-based query router (Phase 1.6)
ENABLE_ROUTER=true

# sql: one Postgres round trip (pgvector + full-text + RRF in SQL, app/database/sql/);
# python: LlamaIndex vector retriever + search_bm25 + RRF in Python (reference path)
RETRIEVAL_MODE=sql

# Staleness Tier 1 in the API: version clusters built at startup, superseded copies
# dropped unless the query is comparative (app/graph/staleness.py)
ENABLE_STALENESS=true

# ===============================
# Observability (optional)
# ===============================
# json: one JSON object per log line (app + uvicorn); text: uvicorn's default
LOG_FORMAT=text
LOG_LEVEL=INFO
# Set to export OpenTelemetry spans for route / embed / hybrid_sql / staleness / rerank
# (pip install -e ".[otel]"; docker compose --profile otel starts Jaeger on :16686)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ===============================
# Database Configuration
# ===============================
# PostgreSQL database URL
PG_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/metanavit
PSYCOPG2_CONNECTION_STRING=dbname=metanavit user=postgres password=password host=localhost port=5432
DB_NAME=metanavit

# ===============================
# Storage Configuration
# ===============================
# Directory paths
FRONTEND_DIR=.frontend
STATIC_DIR=static
DATA_DIR=data
STORAGE_DIR=storage
STORAGE_CACHE_DIR=.cache

# ===============================
# Server Configuration
# ===============================
# The address to start the backend app
APP_HOST=0.0.0.0

# The port to start the backend app
APP_PORT=8000

# File server URL prefix
FILESERVER_URL_PREFIX=http://localhost:8000/api/files

# ===============================
# UI Configuration
# ===============================
# The questions to help users get started (comma-separated)
CONVERSATION_STARTERS=How can I organize my files?,What information can you extract from my documents?,Can you help me find specific content in my dataset?

# Customize system prompt to specify agents role
SYSTEM_PROMPT="You are a helpful AI file system assistant. Your task is to help the user understand and perform tasks related to their files."
# Optional trusted file-edit approval. Leave both empty to refuse writes.
# The operator's Ed25519 public key (python -m app.mcp.approve init) and the
# replay ledger. Keep both outside every agent-readable/indexed root, writable
# only by the operator; never give the server the private key.
METANAVIT_APPROVAL_PUBLIC_KEY_FILE=
METANAVIT_APPROVAL_LEDGER_FILE=

# ===============================
# API access and request limits (all optional)
# ===============================
# Shared API key. Empty = the API is open and /health reports auth.enabled=false.
# When set, every /api route and the /api/files mounts require it, sent as
# "X-API-Key: <key>" or "Authorization: Bearer <key>"; /health stays open.
# The bundled web UI does not send a key.
METANAVIT_API_KEY=

# Per-caller request budget (token bucket, 429 + Retry-After). Empty or 0 = off.
# The buckets are in process memory: the budget is per API replica, not global.
RATE_LIMIT_PER_MINUTE=
# Bucket size (burst). Empty = RATE_LIMIT_PER_MINUTE rounded up.
RATE_LIMIT_BURST=

# Largest file POST /api/chat/upload accepts, in bytes of decoded content (413 past it).
# UPLOAD_MAX_BYTES=10485760

# ===============================
# Python execution tool in chat (off by default)
# ===============================
# The chat's code agent runs Python that the model writes. It is built only when this is
# true AND METANAVIT_API_KEY is set; with the flag but no key it stays off (logged).
# Each call runs in a child process: new session, its own environment reduced to PATH, HOME,
# locale, TZ and TMPDIR (plus one-thread settings for the maths libraries), CPU / memory /
# file-size limits, its process group killed at the time limit and after every call. Not OS
# isolation: the child runs as the API's OS user and can still read the API's start-up
# environment (/proc) and the .env file; a process it starts in a session of its own is not
# killed.
ENABLE_PYTHON_EXEC=false
# Wall-clock (and CPU) seconds per call, and address space per call in MiB.
# PYTHON_EXEC_TIMEOUT_SECONDS=30
# PYTHON_EXEC_MAX_MEMORY_MB=1024
